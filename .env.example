# Modelo de variáveis de ambiente. Copie para .env (que NÃO vai para o git):
#   cp .env.example .env            (Linux/macOS/Git Bash)
#   Copy-Item .env.example .env     (PowerShell)
# e troque as senhas.

# ---------------------------------------------------------------- MongoDB local (container)
MONGO_ROOT_USER=comed_admin
MONGO_ROOT_PASSWORD=troque-esta-senha
MONGO_DATABASE=comed
MONGO_PORT=27017

# ---------------------------------------------------------------- API
API_PORT=8080
# local | staging | production (aparece no selo da página de status)
APP_ENV=local
# No pipeline é o SHA do commit; localmente qualquer rótulo
APP_VERSION=local
# Insere os dados de exemplo se as collections estiverem vazias
SEED_ENABLED=true
# kg de CO2 por km rodado, usado quando a teleconsulta não informa co2EvitadoKg
FATOR_CO2_KG_POR_KM=0.13
JAVA_OPTS=-XX:MaxRAMPercentage=75

# ---------------------------------------------------------------- mongo-express (docker compose --profile tools)
MONGO_EXPRESS_PORT=8081
ME_USER=admin
ME_PASSWORD=troque-esta-senha

# ---------------------------------------------------------------- Fora do docker-compose (Render, mvn spring-boot:run)
# Lidas direto pela aplicação; o docker-compose monta a MONGODB_URI sozinho.
# MONGODB_URI=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/comed_staging?retryWrites=true&w=majority
# SPRING_PROFILES_ACTIVE=staging   # staging | prod
# PORT=8080                        # o Render injeta a própria
